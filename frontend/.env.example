# Deja sin fijar (comentado) para que el frontend use automáticamente el mismo host
# desde el que se abrió la página, puerto 8000 — así también funciona desde otro
# dispositivo en la misma red local (ej. una tablet) sin tocar nada.
# VITE_API_URL=http://localhost:8000

# API Key de Google Maps (Maps JavaScript API + Directions API + Places API habilitadas).
# Mientras esté vacía, el módulo de Delivery sigue funcionando con el mapa simulado y la
# estimación de ruta por aproximación, sin romperse.
VITE_GOOGLE_MAPS_API_KEY=
