# API Key de Anthropic (console.anthropic.com -> Settings -> API Keys -> Create Key).
# Activa las respuestas con IA real de los agentes VALE, YHORGE y ALO. Mientras esté vacía,
# cada agente sigue funcionando con su resumen basado en reglas sobre los mismos datos reales.
ANTHROPIC_API_KEY=

# Modelo a usar (opcional). Por defecto usa Sonnet; puedes cambiarlo a un modelo Haiku
# para reducir costo si vas a consultar a los agentes con mucha frecuencia.
ANTHROPIC_MODEL=claude-sonnet-4-6
