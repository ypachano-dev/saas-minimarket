# ─── 3Q Nexus ERP — Variables de entorno ────────────────────────────────────
# Copia este archivo como .env y rellena los valores reales.
# .env NUNCA debe subirse a git (ya está en .gitignore).

# ── Base de datos ─────────────────────────────────────────────────────────────
# Desarrollo local → dejar sin definir (usa SQLite automáticamente)
# Producción DigitalOcean Managed PostgreSQL:
# DATABASE_URL=postgresql://usuario:password@db-host:25060/3qnexus?sslmode=require

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=cambia_esto_en_produccion

# ── Agentes IA ────────────────────────────────────────────────────────────────
# API Key de Anthropic (console.anthropic.com -> Settings -> API Keys).
# Sin esta key los agentes VALE, YHORGE y ALO operan en modo reglas (sin IA real).
ANTHROPIC_API_KEY=

# Modelo Claude a usar por los agentes (opcional).
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Google Maps (opcional) ────────────────────────────────────────────────────
# Necesario para Delivery con mapa real y GPS de vendedores en Dashboard.
# VITE_GOOGLE_MAPS_API_KEY=AIza...
